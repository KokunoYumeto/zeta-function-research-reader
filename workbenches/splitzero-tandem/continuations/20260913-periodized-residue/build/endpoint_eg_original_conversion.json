          },
          "\n\\min_{0\\le j<r}\\epsilon_{h,k,n+j}\n\\le \\mathcal A_{n,r}\\sinh\\left(\\frac{\\mathcal B_{n,r}}{2r}\\right).\n\\tag{EG.1}\n"
        ]
      },
      "after": {
