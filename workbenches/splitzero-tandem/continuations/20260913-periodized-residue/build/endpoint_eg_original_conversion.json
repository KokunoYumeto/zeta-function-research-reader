      "c": [
        {
          "t": "DisplayMath"
        },
        "\nT_N=\\frac{X_{N+1}}{Y_{N-q+1}},\\qquad\nV_N=\\det G_N=V_N^\\Gamma T_N,\\qquad N\\ge q-1.\n"
      ],
      "c_sha256": "41427c12cfee6a1d647e8e0243ea22423a71fa0654891be67e1b8a45feaf2738"
    },
    {
      "index": 1,
      "path": "/blocks/6/c/0",
      "ancestors": [
        "Para"
      ],
      "c": [
        {
          "t": "DisplayMath"
        },
        "\n\\mathcal A_{n,r}=\\left(\\frac{\\omega_{n+r}}{\\omega_n}\\right)^{1/(2r)},\n\\qquad\n\\mathcal B_{n,r}=\\log\\frac{V_{n-1}V_n}{V_{n+r-1}V_{n+r}}.\n"
      ],
      "c_sha256": "ce8d0a67654f7a7afa662c7570b611b806e8fc73f81540350a41e876bcf88c0f"
    },
    {
      "index": 2,
      "path": "/blocks/8/c/0",
      "ancestors": [
        "Para"
      ],
      "c": [
        {
          "t": "DisplayMath"
        },
        "\n\\min_{0\\le j<r}\\epsilon_{h,k,n+j}\n\\le \\mathcal A_{n,r}\\sinh\\left(\\frac{\\mathcal B_{n,r}}{2r}\\right).\n\\tag{EG.1}\n"
      ],
      "c_sha256": "70903fdbcb64696d336d65ed75da36dce80daeb70d41aa188865146133ec3295"
    },
    {
      "index": 3,
      "path": "/blocks/12/c/0",
      "ancestors": [
        "Para"
      ],
      "c": [
        {
          "t": "DisplayMath"
        },
        "\n\\omega_j=c_\\lambda^k j!(\\alpha_k)_j\\frac{X_{j+1}}{X_j}.\n\\tag{EG.2}\n"
      ],
      "c_sha256": "021d86cad0a9e4be5da24c2ce21f250cb6d54adfa99a9cd8c03c52bd98843384"
    },
    {
      "index": 4,
      "path": "/blocks/14/c/0",
      "ancestors": [
        "Para"
      ],
      "c": [
        {
          "t": "DisplayMath"
        },
        "\n\\boxed{\n\\mathcal A_{n,r}\n=\\bigl((n+1)_r(n+\\alpha_k)_r\\bigr)^{1/(2r)}\n\\left(\\frac{X_{n+r+1}X_n}{X_{n+r}X_{n+1}}\\right)^{1/(2r)}.\n}\n\\tag{EG.3}\n"
      ],
      "c_sha256": "372018e9e6b2733b8f027010b75857af7d758103d2aea86110384a39815885c0"
    },
    {
      "index": 5,
      "path": "/blocks/17/c/0",
      "ancestors": [
        "Para"
      ],
      "c": [
        {
          "t": "DisplayMath"
        },
        "\n\\boxed{\n\\mathcal B_{n,r}\n=\\log\\frac{V_{n-1}^\\Gamma V_n^\\Gamma}\n               {V_{n+r-1}^\\Gamma V_{n+r}^\\Gamma}\n+\\log\\frac{T_{n-1}T_n}{T_{n+r-1}T_{n+r}}.\n}\n\\tag{EG.4}\n"
      ],
      "c_sha256": "f1d5fe7400dcd220aca3be498b83d5273c351ab3c5d28b2a051895c96deb11ed"
    },
    {
      "index": 6,
      "path": "/blocks/22/c/0",
      "ancestors": [
        "Para"
      ],
      "c": [
        {
          "t": "DisplayMath"
        },
        "\n\\boxed{c_{h,0},c_{h,1},\\ldots,c_{h,2(n+r)},\\quad k,\\lambda,\\chi.}\n\\tag{EG.5}\n"
